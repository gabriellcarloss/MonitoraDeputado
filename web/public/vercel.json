{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    { "source": "/duckdb/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=900, stale-while-revalidate=86400" }] }
  ]
}
